# ── Stage 1: Build ──────────────────────────────────────────────────────────
# Use glibc (Debian) node so rollup's native binary matches the lockfile
# platform. Only the final nginx stage needs to be small.
FROM node:20 AS builder

RUN npm install -g pnpm@10

WORKDIR /app

# Copy workspace manifests first for layer caching
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY lib/db/package.json               lib/db/
COPY lib/api-zod/package.json          lib/api-zod/
COPY lib/api-client-react/package.json lib/api-client-react/
COPY artifacts/api-server/package.json artifacts/api-server/
COPY artifacts/platform/package.json   artifacts/platform/

RUN NODE_ENV=development pnpm install --no-frozen-lockfile

# Copy source
COPY lib/db/               lib/db/
COPY lib/api-zod/          lib/api-zod/
COPY lib/api-client-react/ lib/api-client-react/
COPY artifacts/platform/   artifacts/platform/
COPY tsconfig.base.json    ./
COPY tsconfig.json         ./

ENV NODE_ENV=production
ENV PORT=3000
ENV BASE_PATH=/

# Vite embeds the Clerk publishable key and proxy URL in the public browser
# bundle. Compose supplies these public values as build arguments. Fail closed
# rather than producing a signed-out SPA when the key is missing.
ARG VITE_CLERK_PUBLISHABLE_KEY
ARG VITE_CLERK_PROXY_URL
ARG VITE_WOOCOMMERCE_URL
RUN --mount=type=secret,id=clerk_publishable_key,required=false \
    --mount=type=secret,id=clerk_proxy_url,required=false \
    sh -eu -c 'key="${VITE_CLERK_PUBLISHABLE_KEY:-}"; proxy="${VITE_CLERK_PROXY_URL:-}"; \
      if [ -f /run/secrets/clerk_publishable_key ]; then key="$(cat /run/secrets/clerk_publishable_key)"; fi; \
      if [ -f /run/secrets/clerk_proxy_url ]; then proxy="$(cat /run/secrets/clerk_proxy_url)"; fi; \
      test -n "$key"; \
      VITE_CLERK_PUBLISHABLE_KEY="$key" VITE_CLERK_PROXY_URL="$proxy" VITE_WOOCOMMERCE_URL="${VITE_WOOCOMMERCE_URL:-}" \
      pnpm --filter @workspace/platform run build'

# ── Stage 2: Serve with Nginx ────────────────────────────────────────────────
FROM nginx:alpine AS runtime

ARG DEPLOY_SHA=unknown
LABEL org.opencontainers.image.revision=$DEPLOY_SHA \
      com.myorder.deploy-sha=$DEPLOY_SHA

COPY --from=builder /app/artifacts/platform/dist /usr/share/nginx/html

COPY deploy/nginx-spa.conf /etc/nginx/conf.d/default.conf

ARG ENABLE_CLERK_DEV_FAPI=false
RUN if [ "$ENABLE_CLERK_DEV_FAPI" = "true" ]; then \
      sed -i \
        -e "s|https://clerk.myorder.fun https://js.jam.dev|https://clerk.myorder.fun https://*.clerk.accounts.dev https://js.jam.dev|g" \
        -e "s|connect-src 'self'|connect-src 'self' https://*.clerk.accounts.dev|g" \
        /etc/nginx/conf.d/default.conf \
        /usr/share/nginx/html/index.html; \
    fi

EXPOSE 3000
